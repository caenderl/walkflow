{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "env": { "browser": true, "es2022": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/restrict-template-expressions": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-console": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-useless-spread": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "promise/always-return": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "tests/**"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/no-misused-promises": "off",
        "typescript/require-array-sort-compare": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-to-throw-message": "off",
        "typescript/no-base-to-string": "off",
        "unicorn/prefer-set-has": "off",
        "oxc/no-map-spread": "off"
      }
    },
    {
      "files": ["electron/**", "scripts/**", "tests/**", "vite.config.ts"],
      "env": { "browser": false, "node": true }
    },
    {
      "files": ["electron/main.ts", "scripts/**"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unnecessary-condition": "off",
        "typescript/restrict-template-expressions": "off",
        "oxc/no-map-spread": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "dist-desktop", "dist-electron", "release", "pages", "legacy", "site", "public", "node_modules"]
}
