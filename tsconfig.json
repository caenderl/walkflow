{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["web-bluetooth", "vite/client", "vite-plugin-pwa/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The treadmill library from its sources in this repository (packages/ftms-treadmill), through its entry points only
    "paths": {
      "ftms-treadmill": ["./packages/ftms-treadmill/src/index.ts"],
      "ftms-treadmill/*": ["./packages/ftms-treadmill/src/*.ts"]
    }
  },
  "include": ["src"]
}
