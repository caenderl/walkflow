{
  "name": "walkflow",
  "productName": "Walkflow",
  "version": "0.1.0",
  "description": "Open-Source-Steuerung für FTMS-Laufbänder per Web Bluetooth",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "electron": "node scripts/build-desktop.mjs && electron .",
    "dist": "node scripts/build-desktop.mjs && electron-builder --config electron-builder.config.cjs --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/web-bluetooth": "0.0.22",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "main": "dist-electron/main.cjs",
  "author": "Walkflow contributors"
}
