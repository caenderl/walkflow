{
  "name": "walkflow",
  "productName": "Walkflow",
  "version": "0.7.0",
  "description": "Open-source control for FTMS treadmills via Web Bluetooth",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json",
    "build:pages": "npm run typecheck && node scripts/build-pages.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "electron": "node scripts/build-desktop.mjs && electron .",
    "electron:dev": "node scripts/dev-desktop.mjs",
    "dist": "node scripts/build-desktop.mjs && electron-builder --config electron-builder.config.cjs --publish never",
    "icons": "node scripts/make-icons.mjs",
    "relays:check": "node scripts/check-relays.mjs",
    "lint": "oxlint --type-aware --deny-warnings && knip"
  },
  "devDependencies": {
    "@noble/secp256k1": "3.2.0",
    "@trystero-p2p/nostr": "0.26.0",
    "@types/node": "26.6.6",
    "@types/web-bluetooth": "0.0.22",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "ftms-treadmill": "0.2.0",
    "knip": "6.45.1",
    "maplibre-gl": "6.17.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "trystero": "0.26.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "main": "dist-electron/main.cjs",
  "author": "Walkflow contributors",
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.6"
    },
    "@electron/universal": {
      "minimatch": "^11.0.6"
    },
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
