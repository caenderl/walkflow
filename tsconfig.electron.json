{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["electron", "src/i18n/i18n.ts", "src/i18n/locales", "src/platform/version.ts", "src/platform/csp.ts", "src/platform/mime.ts", "src/platform/dev-url.ts", "src/platform/open-files.ts", "src/core/routes/map-config.ts", "src/core/safety/dev-mode.ts"]
}
