{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "pages",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let f1=p.join('pages',u);if(f.existsSync(f1)&&f.statSync(f1).isDirectory())f1=p.join(f1,'index.html');if(!f.existsSync(f1)){r.writeHead(404);return r.end('404')}const t={'.html':'text/html','.css':'text/css','.js':'text/javascript','.webp':'image/webp','.svg':'image/svg+xml'}[p.extname(f1)]||'application/octet-stream';r.writeHead(200,{'content-type':t});f.createReadStream(f1).pipe(r)}).listen(8077)"
      ],
      "port": 8077
    }
  ]
}
